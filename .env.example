# Goblin Tools — édition locale : variables d'environnement
# Copiez ce fichier vers .env (ou définissez les variables dans votre shell).
# Ne jamais commettre de vraies clés API : voir .gitignore.

# --------------------------------------------------------------- Déploiement
# Mode : "local" (127.0.0.1 uniquement) ou "server" (toutes interfaces, défaut)
GOBLIN_MODE=server

# Host d'écoute du serveur (127.0.0.1 en local ; 0.0.0.0 en serveur)
GOBLIN_HOST=127.0.0.1

# Port d'écoute
GOBLIN_PORT=8765

# Répertoire de données (config + persistance). Défaut : à côté de l'exe.
# En mode serveur, pointer vers un volume monté si besoin.
# GOBLIN_DATA_DIR=/var/lib/goblin-tools

# Jeton d'authentification optionnel (Bearer) pour les appels API en mode serveur.
# Laissez vide pour désactiver l'auth (comportement local par défaut).
# GOBLIN_AUTH_TOKEN=changez-moi-en-production

# Origines CORS autorisées (séparées par des virgules). Vide = strict (serveur)
# ou * (local uniquement).
# GOBLIN_CORS_ORIGINS=https://goblin.example.com,https://app.goblin.example.com

# --------------------------------------------------------------- Fournisseur IA
# Mode IA : "distant", "local" ou "auto" (bascule silencieuse si coupure réseau)
GOBLIN_AI_MODE=auto

# Endpoint distant compatible OpenAI (URL + modèle + clé)
GOBLIN_BASE_URL=https://api.deepseek.com/v1
# GOBLIN_API_KEY=sk-...
GOBLIN_MODEL=deepseek-chat

# Endpoint local Ollama (utilisé si GOBLIN_AI_MODE=local ou bascule auto)
# GOBLIN_BASE_URL=http://127.0.0.1:11434/v1

# --------------------------------------------------------------- Moteur IA local
# Chemin vers un binaire llama-server déjà présent (installation hors ligne).
# Si défini, aucun téléchargement depuis GitHub n'est effectué.
# GOBLIN_LLAMA_BIN=/chemin/vers/llama-server

# Chemin vers un modèle GGUF déjà présent (installation hors ligne).
# Si défini, aucun téléchargement depuis Hugging Face n'est effectué.
# GOBLIN_MODEL_PATH=/chemin/vers/Qwen3-4B-Q4_K_M.gguf

# Version de llama.cpp à utiliser (surcharge la version par défaut du catalogue).
# GOBLIN_LLAMA_VERSION=b12110
